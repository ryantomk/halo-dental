# Public — safe to expose to the browser (still RLS-protected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never exposed to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Cloud API (Meta) — used by the notify-new-booking
# and notify-booking-status Supabase Edge Functions
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS gateway (e.g. MSG91 or Twilio)
SMS_GATEWAY_API_KEY=

# Transactional email (e.g. Resend)
RESEND_API_KEY=
